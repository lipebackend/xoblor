local A = require("../src/shared/AtmLogic")

-- mesmo formato do Catalog.FormatReais
local function R(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1."):reverse()
	return "R$ " .. out:gsub("^%.", "")
end

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq

	describe("AtmLogic.Response", function()
		it("mantém Wallet e Bank e acrescenta Moved", function()
			local r = A.Response(100, 900, 50)
			eq(r.Wallet, 100)
			eq(r.Bank, 900)
			eq(r.Moved, 50)
		end)
		it("Moved ausente ou lixo vira 0", function()
			eq(A.Response(1, 2).Moved, 0)
			eq(A.Response(1, 2, 0 / 0).Moved, 0)
			eq(A.Response(1, 2, -5).Moved, 0)
		end)
	end)

	describe("AtmLogic.ErrorMessage", function()
		it("códigos do #29 em pt-BR", function()
			eq(A.ErrorMessage("BankFull"), "Banco cheio: não cabe mais nada")
			eq(A.ErrorMessage("WalletFull"), "Carteira cheia: deposite antes de sacar")
		end)
		it("outros códigos e desconhecido", function()
			eq(A.ErrorMessage("InsufficientFunds"), "Sem grana")
			eq(A.ErrorMessage("Xyz"), "Xyz")
		end)
	end)

	describe("AtmLogic.SuccessMessage", function()
		it("depósito e saque completos", function()
			eq(A.SuccessMessage("deposit", 1000, 1000, R), "Depositado R$ 1.000")
			eq(A.SuccessMessage("withdraw", 50, 50, R), "Sacado R$ 50")
		end)
		it("depósito parcial (banco perto do teto)", function()
			eq(A.SuccessMessage("deposit", 5000, 1200, R), "Depositado R$ 1.200 (de R$ 5.000; banco no limite)")
		end)
		it("saque parcial (carteira perto do teto)", function()
			eq(A.SuccessMessage("withdraw", 5000, 7, R), "Sacado R$ 7 (de R$ 5.000; carteira no limite)")
		end)
		it("saldo ou servidor antigo sem Moved", function()
			eq(A.SuccessMessage("balance", nil, 0, R), "Feito!")
			eq(A.SuccessMessage("deposit", 10, nil, R), "Feito!")
		end)
	end)
end
