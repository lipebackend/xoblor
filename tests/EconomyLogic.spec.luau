local E = require("../src/server/Economy/EconomyLogic")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	local MAX = E.MAX_BALANCE

	describe("EconomyLogic.ValidAmount", function()
		for _, bad in { 0, -1, -100, 1.5, 0 / 0, math.huge, -math.huge, MAX + 1, "10", nil, true } do
			it("recusa " .. tostring(bad), function()
				eq(E.ValidAmount(bad), false)
			end)
		end
		it("aceita 1 e o máximo", function()
			eq(E.ValidAmount(1), true)
			eq(E.ValidAmount(MAX), true)
		end)
	end)

	describe("EconomyLogic.NormalizeBalance", function()
		it("negativo vira 0", function()
			eq(E.NormalizeBalance(-50), 0)
		end)
		it("nil, texto inválido e NaN viram 0", function()
			eq(E.NormalizeBalance(nil), 0)
			eq(E.NormalizeBalance("abc"), 0)
			eq(E.NormalizeBalance(0 / 0), 0)
		end)
		it("fração é truncada e acima do máximo é limitado", function()
			eq(E.NormalizeBalance(12.9), 12)
			eq(E.NormalizeBalance("40"), 40)
			eq(E.NormalizeBalance(MAX * 2), MAX)
		end)
	end)

	describe("EconomyLogic.Add", function()
		it("soma", function()
			local ok, new = E.Add(10, 5)
			eq(ok, true)
			eq(new, 15)
		end)
		it("perto do teto credita só o que cabe e informa o creditado", function()
			local ok, new, credited = E.Add(MAX - 1, 10)
			eq(ok, true)
			eq(new, MAX)
			eq(credited, 1)
		end)
		it("longe do teto credita tudo", function()
			local _, _, credited = E.Add(10, 5)
			eq(credited, 5)
		end)
		it("carteira no teto: WalletFull", function()
			local ok, err = E.Add(MAX, 1)
			eq(ok, false)
			eq(err, "WalletFull")
		end)
		it("valor inválido", function()
			local ok, err = E.Add(10, -5)
			eq(ok, false)
			eq(err, "InvalidAmount")
		end)
		it("perfil não carregado", function()
			local ok, err = E.Add(nil, 5)
			eq(ok, false)
			eq(err, "NotLoaded")
		end)
	end)

	describe("EconomyLogic.Spend (saldo nunca negativo)", function()
		it("gasta", function()
			local ok, new = E.Spend(10, 4)
			eq(ok, true)
			eq(new, 6)
		end)
		it("gasta tudo até 0", function()
			local _, new = E.Spend(10, 10)
			eq(new, 0)
		end)
		it("recusa se ficaria negativo", function()
			local ok, err = E.Spend(10, 11)
			eq(ok, false)
			eq(err, "InsufficientFunds")
		end)
		it("recusa valor negativo (que aumentaria o saldo)", function()
			local ok, err = E.Spend(10, -5)
			eq(ok, false)
			eq(err, "InvalidAmount")
		end)
		it("recusa zero, fração e NaN", function()
			eq((E.Spend(10, 0)), false)
			eq((E.Spend(10, 0.5)), false)
			eq((E.Spend(10, 0 / 0)), false)
		end)
	end)

	describe("EconomyLogic.Transfer", function()
		it("sucesso move o valor exato", function()
			local ok, from, to = E.Transfer(100, 50, 30, false)
			eq(ok, true)
			eq(from, 70)
			eq(to, 80)
		end)
		it("conserva o total", function()
			local _, from, to = E.Transfer(100, 50, 100, false)
			eq(from + to, 150)
			eq(from, 0)
		end)
		it("saldo insuficiente", function()
			local ok, err = E.Transfer(10, 0, 11, false)
			eq(ok, false)
			eq(err, "InsufficientFunds")
		end)
		it("para si mesmo", function()
			local ok, err = E.Transfer(100, 100, 10, true)
			eq(ok, false)
			eq(err, "SamePlayer")
		end)
		for _, bad in { 0, -10, 2.5, 0 / 0, math.huge, "10" } do
			it("valor inválido " .. tostring(bad), function()
				local ok, err = E.Transfer(100, 0, bad, false)
				eq(ok, false)
				eq(err, "InvalidAmount")
			end)
		end
		it("perfil não carregado em qualquer lado", function()
			eq(select(2, E.Transfer(nil, 0, 1, false)), "NotLoaded")
			eq(select(2, E.Transfer(10, nil, 1, false)), "NotLoaded")
		end)
		it("atomicidade: falha não devolve saldos novos", function()
			local ok, a, b = E.Transfer(5, 5, 6, false)
			eq(ok, false)
			eq(a, "InsufficientFunds")
			eq(b, nil)
		end)
		it("destino no máximo: recusa em vez de sumir com o excedente", function()
			local ok, err = E.Transfer(100, MAX - 10, 50, false)
			eq(ok, false)
			eq(err, "RecipientFull")
		end)
		it("destino chega exatamente no máximo", function()
			local ok, _, to = E.Transfer(100, MAX - 10, 10, false)
			eq(ok, true)
			eq(to, MAX)
		end)
	end)

	describe("EconomyLogic.SplitCredit (Robux)", function()
		it("tudo na carteira quando cabe", function()
			local w, b, lost = E.SplitCredit(0, 0, 500)
			eq(w, 500)
			eq(b, 0)
			eq(lost, 0)
		end)
		it("excedente vai para o banco", function()
			local w, b, lost = E.SplitCredit(MAX - 100, 0, 500)
			eq(w, 100)
			eq(b, 400)
			eq(lost, 0)
		end)
		it("carteira cheia: tudo no banco", function()
			local w, b = E.SplitCredit(MAX, 0, 500)
			eq(w, 0)
			eq(b, 500)
		end)
		it("carteira e banco no teto: perdido informado", function()
			local w, b, lost = E.SplitCredit(MAX, MAX - 50, 500)
			eq(w, 0)
			eq(b, 50)
			eq(lost, 450)
		end)
		it("soma sempre igual ao valor pago", function()
			for _, wallet in { 0, MAX - 1, MAX } do
				for _, bank in { 0, MAX - 1, MAX } do
					local w, b, lost = E.SplitCredit(wallet, bank, 1200)
					eq(w + b + lost, 1200)
				end
			end
		end)
	end)

	describe("EconomyLogic.PixUsed", function()
		it("soma só a janela e descarta o resto", function()
			local log = { { t = 0, v = 1000 }, { t = 3000, v = 200 }, { t = 3500, v = 300 } }
			local used, kept = E.PixUsed(log, 3600, 3600)
			eq(used, 500)
			eq(#kept, 2)
		end)
		it("log vazio", function()
			local used, kept = E.PixUsed({}, 100, 3600)
			eq(used, 0)
			eq(#kept, 0)
		end)
	end)
end
