local M = require("../src/server/Economy/MedicLogic")

return function(T)
	local describe, it, eq, truthy = T.describe, T.it, T.eq, T.truthy
	local C = M.Config

	describe("MedicLogic.Config (padrões)", function()
		it("valores combinados", function()
			eq(C.FAINT_AFTER, 30)
			eq(C.BLEEDOUT, 90)
			eq(C.HOSPITAL_FEE, 100)
			eq(C.REVIVE_FEE, 50)
			eq(C.REVIVE_DISTANCE, 8)
			eq(C.REVIVE_COOLDOWN, 10)
			eq(C.RESTORE_NEEDS, 30)
			eq(C.ROB_DOWNED, false)
			truthy(C.BLOCKED.Rob and C.BLOCKED.Buy and C.BLOCKED.Pix and C.BLOCKED.Job)
		end)
	end)

	describe("MedicLogic.FaintStep", function()
		it("começa a contar e desmaia em FAINT_AFTER", function()
			local z, faint = M.FaintStep(nil, true, false, false, 100)
			eq(z, 100)
			eq(faint, false)
			z, faint = M.FaintStep(z, true, false, false, 129)
			eq(faint, false)
			z, faint = M.FaintStep(z, true, false, false, 130)
			eq(faint, true)
		end)
		it("comer zera a contagem", function()
			local z = M.FaintStep(nil, true, false, false, 100)
			z = M.FaintStep(z, false, false, false, 120)
			eq(z, nil)
			local faint
			z, faint = M.FaintStep(z, true, false, false, 140)
			eq(z, 140)
			eq(faint, false)
		end)
		it("preso não desmaia", function()
			local z, faint = M.FaintStep(0, true, true, false, 1000)
			eq(z, nil)
			eq(faint, false)
		end)
		it("já desmaiado não desmaia de novo", function()
			local _, faint = M.FaintStep(0, true, false, true, 1000)
			eq(faint, false)
		end)
	end)

	describe("MedicLogic.BleedoutLeft", function()
		it("conta de BLEEDOUT até 0", function()
			eq(M.BleedoutLeft(100, 100), 90)
			eq(M.BleedoutLeft(100, 150), 40)
			eq(M.BleedoutLeft(100, 190), 0)
			eq(M.BleedoutLeft(100, 500), 0)
		end)
	end)

	describe("MedicLogic.Fee", function()
		it("limitada à carteira e nunca negativa", function()
			eq(M.Fee(100, 1000), 100)
			eq(M.Fee(100, 30), 30)
			eq(M.Fee(100, 0), 0)
			eq(M.Fee(100, -50), 0)
			eq(M.Fee(50, 0 / 0), 0)
			eq(M.Fee(50, 49.9), 49)
		end)
	end)

	describe("MedicLogic.RestoreDelta", function()
		it("leva até 30 sem baixar", function()
			eq(M.RestoreDelta(0), 30)
			eq(M.RestoreDelta(12), 18)
			eq(M.RestoreDelta(80), 0)
		end)
	end)

	describe("MedicLogic.CanRevive", function()
		local function base(o)
			local a = { IsMedic = true, MedicDowned = false, MedicJailed = false, CooldownUntil = 0, TargetDowned = true, Distance = 3, Now = 1000 }
			for k, v in pairs(o or {}) do
				a[k] = v
			end
			return a
		end
		it("caso válido", function()
			eq(M.CanRevive(base()), nil)
		end)
		it("só médico", function()
			eq(M.CanRevive(base({ IsMedic = false })), "NotMedic")
		end)
		it("médico desmaiado ou preso", function()
			eq(M.CanRevive(base({ MedicDowned = true })), "Downed")
			eq(M.CanRevive(base({ MedicJailed = true })), "Jailed")
		end)
		it("cooldown", function()
			eq(M.CanRevive(base({ CooldownUntil = 1005 })), "Cooldown")
		end)
		it("alvo não desmaiado", function()
			eq(M.CanRevive(base({ TargetDowned = false })), "NotDowned")
		end)
		it("distância", function()
			eq(M.CanRevive(base({ Distance = 8 })), nil)
			eq(M.CanRevive(base({ Distance = 8.1 })), "TooFar")
			eq(M.CanRevive(base({ Distance = 0 / 0 })), "TooFar")
		end)
	end)

	describe("MedicLogic.Allowed / CanBeRobbed", function()
		it("desmaiado bloqueado", function()
			for _, act in { "Rob", "Buy", "Pix", "Job" } do
				eq(M.Allowed(act, true), false)
				eq(M.Allowed(act, false), true)
			end
		end)
		it("assalto a desmaiado configurável", function()
			eq(M.CanBeRobbed(true), false)
			eq(M.CanBeRobbed(false), true)
			eq(M.CanBeRobbed(true, { ROB_DOWNED = true }), true)
		end)
	end)
end
