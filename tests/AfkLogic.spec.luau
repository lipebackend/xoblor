local A = require("../src/server/Economy/AfkLogic")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	local cfg = { TIMEOUT = 300, MOVE_THRESHOLD = 4, INTERACTION_ONLY_MAX = 600 }
	local function v(x, y, z)
		return { X = x, Y = y or 0, Z = z or 0 }
	end

	describe("AfkLogic", function()
		it("recém-chegado não é AFK", function()
			local s = A.New(0)
			eq(A.IsAfk(s, 299, cfg), false)
		end)
		it("limite do timeout: 299 não, 300 sim", function()
			local s = A.New(0)
			eq(A.IsAfk(s, 299.9, cfg), false)
			eq(A.IsAfk(s, 300, cfg), true)
		end)
		it("primeira amostra só ancora, não conta como movimento", function()
			local s = A.New(0)
			eq(A.Observe(s, v(0), 200, cfg), false)
			eq(A.IsAfk(s, 300, cfg), true)
		end)
		it("mover além do limite reinicia o tempo", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			eq(A.Observe(s, v(10), 250, cfg), true)
			eq(A.IsAfk(s, 300, cfg), false)
			eq(A.IsAfk(s, 550, cfg), true)
		end)
		it("tremida pequena não reinicia", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			for t = 2, 400, 2 do
				A.Observe(s, v((t % 4 == 0) and 1 or -1, 0.5), t, cfg)
			end
			eq(A.IsAfk(s, 400, cfg), true)
		end)
		it("exatamente no limite não conta; acima conta", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			eq(A.Observe(s, v(4), 2, cfg), false)
			eq(A.Observe(s, v(4.01), 3, cfg), true)
		end)
		it("andar devagar acumula a partir da âncora", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			local moved = false
			for i = 1, 10 do
				moved = A.Observe(s, v(i), 1 + i, cfg) or moved
			end
			eq(moved, true)
		end)
		it("movimento vertical também conta", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			eq(A.Observe(s, v(0, 10), 2, cfg), true)
		end)
		it("respawn/teleporte: reancora sem contar como atividade", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			A.Reanchor(s, v(500))
			eq(A.Observe(s, v(500), 2, cfg), false)
			eq(A.IsAfk(s, 300, cfg), true)
		end)
		it("reancorar com nil: próxima amostra só ancora", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			A.Reanchor(s, nil)
			eq(A.Observe(s, v(999), 2, cfg), false)
		end)
		it("sem personagem: nada muda e o tempo corre", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			eq(A.Observe(s, nil, 100, cfg), false)
			eq(A.IsAfk(s, 300, cfg), true)
		end)
		it("ação no servidor reinicia o tempo", function()
			local s = A.New(0)
			A.MarkActive(s, 290)
			eq(A.IsAfk(s, 300, cfg), false)
			eq(A.IsAfk(s, 590, cfg), true)
		end)
		it("MarkActive com tempo antigo não volta o relógio", function()
			local s = A.New(100)
			A.MarkActive(s, 50)
			eq(s.lastActive, 100)
		end)
		it("Idled só deixa mais inativo", function()
			local s = A.New(0)
			A.MarkActive(s, 250)
			A.MarkIdled(s, 260, 120)
			eq(s.lastActive, 140)
			A.MarkIdled(s, 260, 1)
			eq(s.lastActive, 140)
		end)
		it("Idled com valor inválido é ignorado", function()
			local s = A.New(10)
			A.MarkIdled(s, 20, 0 / 0)
			A.MarkIdled(s, 20, -5)
			A.MarkIdled(s, 20, "x")
			eq(s.lastActive, 10)
		end)
	end)

	describe("AfkLogic.MarkInteraction (anti-spam)", function()
		it("interação reinicia o tempo logo depois de mover", function()
			local s = A.New(0)
			A.Observe(s, v(0), 1, cfg)
			A.Observe(s, v(10), 100, cfg)
			A.MarkInteraction(s, 350, cfg)
			eq(A.IsAfk(s, 600, cfg), false)
		end)
		it("parado spamando prompt: ativo no máximo até lastMove + 600 + 300", function()
			local s = A.New(0)
			A.Observe(s, v(0), 0, cfg)
			for t = 10, 2000, 10 do
				A.MarkInteraction(s, t, cfg)
			end
			eq(s.lastActive, 600)
			eq(A.IsAfk(s, 899, cfg), false)
			eq(A.IsAfk(s, 900, cfg), true)
			eq(A.IsAfk(s, 2000, cfg), true)
		end)
		it("mover de novo libera nova janela de interação", function()
			local s = A.New(0)
			A.Observe(s, v(0), 0, cfg)
			A.MarkInteraction(s, 2000, cfg)
			eq(A.IsAfk(s, 2000, cfg), true)
			A.Observe(s, v(10), 2000, cfg)
			A.MarkInteraction(s, 2500, cfg)
			eq(s.lastActive, 2500)
		end)
		it("tremida não libera janela nova", function()
			local s = A.New(0)
			A.Observe(s, v(0), 0, cfg)
			A.Observe(s, v(1), 1000, cfg)
			A.MarkInteraction(s, 1000, cfg)
			eq(s.lastActive, 600)
		end)
		it("interação nunca volta o relógio", function()
			local s = A.New(0)
			A.Observe(s, v(0), 0, cfg)
			A.Observe(s, v(10), 1000, cfg)
			A.MarkInteraction(s, 500, cfg)
			eq(s.lastActive, 1000)
		end)
	end)
end
