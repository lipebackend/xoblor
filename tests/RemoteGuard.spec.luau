local G = require("../src/server/Economy/RemoteGuard")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	local V = G.V
	local NAN, INF = 0 / 0, math.huge

	describe("RemoteGuard.Take (rate limit)", function()
		it("permite o burst e depois recusa", function()
			local ok, b = G.Take(nil, 0, 1, 2)
			eq(ok, true)
			ok = G.Take(b, 0, 1, 2)
			eq(ok, true)
			ok = G.Take(b, 0, 1, 2)
			eq(ok, false)
		end)
		it("recarrega 1 token por intervalo", function()
			local _, b = G.Take(nil, 0, 0.5, 1)
			eq((G.Take(b, 0.4, 0.5, 1)), false)
			eq((G.Take(b, 0.9, 0.5, 1)), true)
		end)
		it("não acumula acima do burst depois de muito tempo parado", function()
			local _, b = G.Take(nil, 0, 1, 2)
			G.Take(b, 1000, 1, 2)
			G.Take(b, 1000, 1, 2)
			eq((G.Take(b, 1000, 1, 2)), false)
		end)
		it("spam constante: só passa na taxa permitida", function()
			local b, passed = nil, 0
			for i = 0, 99 do
				local ok
				ok, b = G.Take(b, i * 0.1, 1, 1) -- 10 chamadas/s por 10s
				if ok then
					passed += 1
				end
			end
			eq(passed, 10)
		end)
		it("relógio voltando ou NaN não recarrega", function()
			local _, b = G.Take(nil, 10, 1, 1)
			eq((G.Take(b, 5, 1, 1)), false)
			eq((G.Take(b, NAN, 1, 1)), false)
		end)
	end)

	describe("RemoteGuard validadores", function()
		it("IsInt recusa NaN, inf, fração, texto e fora da faixa", function()
			for _, bad in { NAN, INF, -INF, 1.5, "1", true, {}, nil } do
				eq(G.IsInt(bad, 1, 10), false)
			end
			eq(G.IsInt(0, 1, 10), false)
			eq(G.IsInt(11, 1, 10), false)
			eq(G.IsInt(5, 1, 10), true)
		end)
		it("Money: 1..1e12", function()
			eq(V.Money(1), true)
			eq(V.Money(1e12), true)
			eq(V.Money(1e12 + 1), false)
			eq(V.Money(0), false)
			eq(V.Money(-5), false)
			eq(V.Money(INF), false)
		end)
		it("UserId: 1..2^53", function()
			eq(V.UserId(123), true)
			eq(V.UserId(2 ^ 60), false)
			eq(V.UserId(0), false)
		end)
		it("Id: alfanumérico e _, até 64", function()
			eq(V.Id("pao_de_queijo"), true)
			eq(V.Id(""), false)
			eq(V.Id("a b"), false)
			eq(V.Id("../x"), false)
			eq(V.Id(string.rep("a", 65)), false)
			eq(V.Id(5), false)
		end)
		it("OneOf", function()
			local f = V.OneOf("a", "b")
			eq(f("a"), true)
			eq(f("c"), false)
			eq(f(nil), false)
		end)
		it("Optional aceita nil e vazio", function()
			local f = V.Optional(V.Id)
			eq(f(nil), true)
			eq(f(""), true)
			eq(f("ok"), true)
			eq(f("x y"), false)
		end)
	end)

	describe("RemoteGuard.Check (schema)", function()
		local pix = { V.UserId, V.Money }
		it("argumentos válidos", function()
			eq(G.Check(pix, 2, { 10, 500 }), true)
		end)
		it("aponta o argumento inválido", function()
			local ok, i = G.Check(pix, 2, { 10, NAN })
			eq(ok, false)
			eq(i, 2)
			ok, i = G.Check(pix, 2, { "10", 5 })
			eq(i, 1)
		end)
		it("faltando argumento obrigatório", function()
			local ok, i = G.Check(pix, 1, { 10 })
			eq(ok, false)
			eq(i, 2)
		end)
		it("argumentos a mais são recusados", function()
			local ok, i = G.Check({}, 1, { "x" })
			eq(ok, false)
			eq(i, 1)
			eq(G.Check(pix, 3, { 10, 5, 1 }), false)
		end)
		it("opcionais no fim podem faltar", function()
			local house = { V.OneOf("list", "rent"), V.Optional(V.Id), V.Optional(V.UserId) }
			eq(G.Check(house, 1, { "list" }), true)
			eq(G.Check(house, 2, { "list", "" }), true)
			eq(G.Check(house, 2, { "rent", "casa_1" }), true)
		end)
	end)

	describe("RemoteGuard.Within (distância)", function()
		local function v(x, y, z)
			return { X = x, Y = y or 0, Z = z or 0 }
		end
		it("dentro e no limite", function()
			eq((G.Within(v(0), v(5), 8)), true)
			eq((G.Within(v(0), v(8), 8)), true)
		end)
		it("fora", function()
			eq((G.Within(v(0), v(8.01), 8)), false)
			eq((G.Within(v(0), v(0, 9), 8)), false)
		end)
		it("sem personagem", function()
			eq((G.Within(nil, v(0), 8)), false)
			eq((G.Within(v(0), nil, 8)), false)
		end)
		it("NaN e infinito nunca passam", function()
			eq((G.Within(v(NAN), v(0), 8)), false)
			eq((G.Within(v(INF), v(0), 8)), false)
			eq((G.Within(v(0), v(0, -INF), math.huge)), false)
		end)
		it("devolve a distância", function()
			local _, d = G.Within(v(0), v(3, 4), 100)
			eq(d, 5)
		end)
	end)
end
