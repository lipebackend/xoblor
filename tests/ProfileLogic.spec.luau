local P = require("../src/server/Economy/ProfileLogic")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	local NOW = 1000000

	describe("ProfileLogic.LockDecision", function()
		it("perfil novo ou sem trava: acquire", function()
			eq(P.LockDecision(nil, "A", NOW), "acquire")
			eq(P.LockDecision({}, "A", NOW), "acquire")
		end)
		it("trava nossa: acquire", function()
			eq(P.LockDecision({ SessionJobId = "A", SessionTime = NOW }, "A", NOW), "acquire")
		end)
		it("trava viva de outro servidor: locked", function()
			eq(P.LockDecision({ SessionJobId = "B", SessionTime = NOW - 10 }, "A", NOW), "locked")
		end)
		it("limite: 299s locked, 300s stale", function()
			eq(P.LockDecision({ SessionJobId = "B", SessionTime = NOW - 299 }, "A", NOW), "locked")
			eq(P.LockDecision({ SessionJobId = "B", SessionTime = NOW - 300 }, "A", NOW), "stale")
		end)
		it("trava sem horário é morta", function()
			eq(P.LockDecision({ SessionJobId = "B" }, "A", NOW), "stale")
		end)
	end)

	describe("ProfileLogic.Backoff", function()
		it("dobra e para no teto (sem jitter)", function()
			eq(P.Backoff(1, 1, 8), 1)
			eq(P.Backoff(2, 1, 8), 2)
			eq(P.Backoff(4, 1, 8), 8)
			eq(P.Backoff(9, 1, 8), 8)
		end)
		it("jitter fica entre 0 e o teto da tentativa", function()
			eq(
				P.Backoff(3, 1, 8, function()
					return 0.5
				end),
				2
			)
			eq(
				P.Backoff(3, 1, 8, function()
					return 0
				end),
				0
			)
		end)
		it("soma das esperas cabe no BindToClose", function()
			local total = 0
			for i = 1, 4 do
				total += P.Backoff(i, 1, 8)
			end
			T.truthy(total < 25, "total " .. total)
		end)
	end)

	describe("ProfileLogic.Migrate", function()
		it("perfil vazio ganha defaults e versão atual", function()
			local d = P.Migrate(nil, NOW)
			eq(d.Coins, 0)
			eq(type(d.Extra), "table")
			eq(d.Jail.Remaining, 0)
			eq(d.Jail.Reason, "")
			eq(d.Version, P.SCHEMA_VERSION)
		end)
		it("v1 mantém moedas, Extra e recibos", function()
			local d = P.Migrate({ Version = 1, Coins = 50, Extra = { Receipts = { abc = 1 }, Bank = 7 } }, NOW)
			eq(d.Coins, 50)
			eq(d.Extra.Receipts.abc, 1)
			eq(d.Extra.Bank, 7)
			eq(d.Jail.Remaining, 0)
		end)
		it("lixo em Coins/Extra/Jail é corrigido", function()
			local d = P.Migrate({ Coins = "x", Extra = 5, Jail = "preso" }, NOW)
			eq(d.Coins, 0)
			eq(type(d.Extra), "table")
			eq(d.Jail.Remaining, 0)
		end)
		it("desmaio salvo por engano some ao carregar", function()
			local d = P.Migrate({ Extra = { Downed = true, DownedLeft = 10, Bank = 3 } }, NOW)
			eq(d.Extra.Downed, nil)
			eq(d.Extra.DownedLeft, nil)
			eq(d.Extra.Bank, 3)
		end)
		it("versão mais nova é recusada", function()
			local d, err = P.Migrate({ Version = P.SCHEMA_VERSION + 1 }, NOW)
			eq(d, nil)
			eq(err, "TooNew")
		end)
		it("não altera a tabela original", function()
			local old = { Coins = 5 }
			P.Migrate(old, NOW)
			eq(old.Version, nil)
		end)
	end)

	describe("ProfileLogic.NormalizeJail", function()
		it("Remaining válido é mantido", function()
			local j = P.NormalizeJail({ Remaining = 120, Reason = "assalto" }, NOW)
			eq(j.Remaining, 120)
			eq(j.Reason, "assalto")
		end)
		it("legado EndsAt é descartado (solto), como no ArrestLogic", function()
			local j = P.NormalizeJail({ EndsAt = NOW + 90, Reason = "assalto" }, NOW)
			eq(j.Remaining, 0)
			eq(j.Reason, "")
			eq(j.EndsAt, nil)
		end)
		it("Remaining convive com EndsAt legado", function()
			local j = P.NormalizeJail({ Remaining = 10, EndsAt = NOW + 999 }, NOW)
			eq(j.Remaining, 10)
			eq(j.EndsAt, nil)
		end)
		it("negativo, NaN, fração e Reason inválido", function()
			eq(P.NormalizeJail({ Remaining = -5 }, NOW).Remaining, 0)
			eq(P.NormalizeJail({ Remaining = 0 / 0 }, NOW).Remaining, 0)
			eq(P.NormalizeJail({ Remaining = 9.2 }, NOW).Remaining, 10)
			eq(P.NormalizeJail({ Remaining = 9, Reason = 42 }, NOW).Reason, "")
			eq(#P.NormalizeJail({ Remaining = 9, Reason = string.rep("a", 200) }, NOW).Reason, 64)
		end)
	end)

	describe("ProfileLogic.BuildSave", function()
		it("grava e mantém a trava", function()
			local n = P.BuildSave({ SessionJobId = "A" }, "A", NOW, 10, {}, { Remaining = 5, Reason = "x" }, false)
			eq(n.Coins, 10)
			eq(n.SessionJobId, "A")
			eq(n.Jail.Remaining, 5)
			eq(n.Version, P.SCHEMA_VERSION)
		end)
		it("release solta a trava", function()
			eq(P.BuildSave({ SessionJobId = "A" }, "A", NOW, 10, {}, nil, true).SessionJobId, nil)
		end)
		it("outro dono: não sobrescreve", function()
			eq(P.BuildSave({ SessionJobId = "B" }, "A", NOW, 10, {}, nil, false), nil)
		end)
		it("perfil de versão mais nova: não sobrescreve", function()
			eq(P.BuildSave({ Version = P.SCHEMA_VERSION + 1 }, "A", NOW, 10, {}, nil, false), nil)
		end)
		it("só grava campos conhecidos (desmaio no topo é descartado)", function()
			local n = P.BuildSave({ Downed = true, Lixo = 1 }, "A", NOW, 0, {}, nil, false)
			eq(n.Downed, nil)
			eq(n.Lixo, nil)
		end)
		it("desmaio no Extra nunca é salvo, o resto do Extra é", function()
			local extra = { Downed = true, DownedLeft = 30, Fainted = true, Bank = 5, Receipts = { r = 1 } }
			local n = P.BuildSave(nil, "A", NOW, 0, extra, nil, false)
			eq(n.Extra.Downed, nil)
			eq(n.Extra.DownedLeft, nil)
			eq(n.Extra.Fainted, nil)
			eq(n.Extra.Bank, 5)
			eq(n.Extra.Receipts.r, 1)
			eq(extra.Downed, true, "não altera a tabela viva")
		end)
		it("Jail ausente grava solto", function()
			eq(P.BuildSave(nil, "A", NOW, 0, {}, nil, false).Jail.Remaining, 0)
		end)
	end)
end
