local M = require("../src/server/Economy/MoveLogic")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	local cfg = M.Config
	local function v(x, y, z)
		return { X = x, Y = y or 0, Z = z or 0 }
	end
	-- anda em linha reta a `speed` studs/s, amostrando a cada 0,5s; devolve os resultados
	local function walk(s, speed, maxSpeed, steps, t0)
		local t, x, out = t0 or 0, 0, {}
		M.Sample(s, v(0), t, maxSpeed)
		for _ = 1, steps do
			t += 0.5
			x += speed * 0.5
			table.insert(out, M.Sample(s, v(x), t, maxSpeed))
		end
		return out, t
	end

	describe("MoveLogic.MaxSpeed", function()
		it("a pé usa o WalkSpeed do servidor", function()
			eq(M.MaxSpeed(16, nil), 16)
			eq(M.MaxSpeed(24, nil), 24)
		end)
		it("WalkSpeed inválido vira 16", function()
			eq(M.MaxSpeed(0 / 0, nil), 16)
			eq(M.MaxSpeed(-5, nil), 16)
		end)
		it("sentado num VehicleSeat: piso de VEHICLE_SPEED", function()
			eq(M.MaxSpeed(16, 25), cfg.VEHICLE_SPEED)
			eq(M.MaxSpeed(16, 200), 200)
			eq(M.MaxSpeed(16, 0 / 0), cfg.VEHICLE_SPEED)
		end)
	end)

	describe("MoveLogic.Sample", function()
		it("primeira amostra só ancora", function()
			eq(M.Sample(M.New(), v(0), 0, 16), "anchor")
		end)
		it("andando normal: sempre ok, nunca bloqueia", function()
			local s = M.New()
			local out, t = walk(s, 16, 16, 40)
			for _, r in out do
				eq(r, "ok")
			end
			eq(M.IsBlocked(s, t), false)
		end)
		it("correndo no limite da folga ainda é ok", function()
			local s = M.New()
			local out = walk(s, 16 * cfg.SPEED_SLACK, 16, 10)
			eq(out[#out], "ok")
		end)
		it("teleporte a pé: jump e bloqueia por BLOCK_SECONDS", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 16)
			eq(M.Sample(s, v(300), 0.5, 16), "jump")
			eq(M.IsBlocked(s, 0.5), true)
			eq(M.IsBlocked(s, 0.5 + cfg.BLOCK_SECONDS - 0.01), true)
			eq(M.IsBlocked(s, 0.5 + cfg.BLOCK_SECONDS), false)
			eq(s.Jumps, 1)
		end)
		it("speed hack constante é pego", function()
			local s = M.New()
			local out = walk(s, 100, 16, 4)
			eq(out[1], "jump")
		end)
		it("de moto/carro: 100 studs/s é ok", function()
			local s = M.New()
			local max = M.MaxSpeed(16, 25)
			local out = walk(s, 100, max, 20)
			for _, r in out do
				eq(r, "ok")
			end
		end)
		it("de carro, teleporte grande ainda é pego", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 120)
			eq(M.Sample(s, v(2000), 0.5, 120), "jump")
		end)
		it("queda livre não conta; subir rápido demais conta", function()
			local s = M.New()
			M.Sample(s, v(0, 500), 0, 16)
			eq(M.Sample(s, v(0, 400), 0.5, 16), "ok")
			eq(M.Sample(s, v(0, 600), 1, 16), "jump")
		end)
		it("pulo normal é ok", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 16)
			eq(M.Sample(s, v(4, 7), 0.5, 16), "ok")
		end)
		it("posição NaN/inf é sempre jump", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 16)
			eq(M.Sample(s, v(0 / 0), 0.5, 16), "jump")
			eq(M.Sample(s, v(0, math.huge), 1, 16), "jump")
		end)
		it("sem personagem: próxima amostra só ancora (sem falso positivo)", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 16)
			eq(M.Sample(s, nil, 0.5, 16), "anchor")
			eq(M.Sample(s, v(5000), 1, 16), "anchor")
			eq(M.IsBlocked(s, 1), false)
		end)
	end)

	describe("MoveLogic.AllowTeleport (cadeia, soltura, hospital, casa, respawn)", function()
		it("teleporte do servidor não bloqueia", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 16)
			M.AllowTeleport(s, 0.4)
			eq(M.Sample(s, v(800), 0.5, 16), "anchor")
			eq(M.Sample(s, v(805), 1, 16), "ok")
			eq(M.IsBlocked(s, 1), false)
		end)
		it("correção de rede dentro da janela é ignorada", function()
			local s = M.New()
			M.Sample(s, v(0), 0, 16)
			M.AllowTeleport(s, 0.4)
			M.Sample(s, v(0), 0.5, 16) -- amostra antes do PivotTo replicar
			eq(M.Sample(s, v(800), 1, 16), "grace")
			eq(M.IsBlocked(s, 1), false)
		end)
		it("depois da janela, salto volta a ser pego", function()
			local s = M.New()
			M.AllowTeleport(s, 0)
			M.Sample(s, v(0), 0.5, 16)
			eq(M.Sample(s, v(800), cfg.TELEPORT_GRACE + 0.5, 16), "jump")
		end)
		it("IsBlocked com estado ausente é falso", function()
			eq(M.IsBlocked(nil, 10), false)
		end)
	end)
end
