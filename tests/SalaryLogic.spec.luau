local S = require("../src/server/Economy/SalaryLogic")
local ArrestLogic = require("../src/server/Economy/ArrestLogic")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	local function jailed(j)
		return ArrestLogic.IsJailed(j)
	end

	describe("SalaryLogic.Check", function()
		it("ativo e solto: paga", function()
			eq(S.Check({ Afk = false, Jailed = false }), nil)
		end)
		it("AFK: não paga", function()
			eq(S.Check({ Afk = true, Jailed = false }), "Afk")
		end)
		it("preso: não paga, mesmo ativo", function()
			eq(S.Check({ Afk = false, Jailed = true }), "Jailed")
		end)
		it("preso e AFK: motivo é Jailed", function()
			eq(S.Check({ Afk = true, Jailed = true }), "Jailed")
		end)
		it("corrida (sem Afk): só o preso é barrado", function()
			eq(S.Check({ Jailed = false }), nil)
			eq(S.Check({ Jailed = true }), "Jailed")
		end)
	end)

	describe("SalaryLogic com Jail do perfil (GetJail)", function()
		it("Remaining > 0 bloqueia", function()
			eq(S.Check({ Jailed = jailed({ Remaining = 30, Reason = "assalto" }) }), "Jailed")
		end)
		it("fração de segundo restante ainda é preso", function()
			eq(S.Check({ Jailed = jailed({ Remaining = 0.2 }) }), "Jailed")
		end)
		it("Remaining = 0, ausente, corrompido ou só EndsAt: solto", function()
			eq(S.Check({ Jailed = jailed({ Remaining = 0, Reason = "" }) }), nil)
			eq(S.Check({ Jailed = jailed(nil) }), nil)
			eq(S.Check({ Jailed = jailed({ Remaining = "x" }) }), nil)
			eq(S.Check({ Jailed = jailed({ EndsAt = 9e9 }) }), nil)
		end)
	end)
end
