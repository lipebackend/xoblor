local N = require("../src/server/Economy/NeedsLogic")

return function(T)
	local describe, it, eq = T.describe, T.it, T.eq
	describe("NeedsLogic.Clamp", function()
		it("ausente/NaN/lixo vira 100", function()
			eq(N.Clamp(nil), 100)
			eq(N.Clamp(0 / 0), 100)
			eq(N.Clamp("x"), 100)
		end)
		it("limita em [0, 100] e trunca", function()
			eq(N.Clamp(-5), 0)
			eq(N.Clamp(250), 100)
			eq(N.Clamp(42.7), 42)
		end)
	end)
	describe("NeedsLogic.ValidDelta", function()
		it("aceita inteiros positivos e negativos", function()
			eq(N.ValidDelta(-1), true)
			eq(N.ValidDelta(30), true)
		end)
		it("recusa fração, NaN, infinito e texto", function()
			eq(N.ValidDelta(0.5), false)
			eq(N.ValidDelta(0 / 0), false)
			eq(N.ValidDelta(math.huge), false)
			eq(N.ValidDelta("1"), false)
		end)
	end)
	describe("NeedsLogic.Apply", function()
		it("decai e não passa de 0", function()
			eq(N.Apply(1, -1), 0)
			eq(N.Apply(0, -1), 0)
		end)
		it("come e não passa de 100", function()
			eq(N.Apply(90, 30), 100)
		end)
	end)
	describe("NeedsLogic.IsExhausted", function()
		it("fome ou energia em 0", function()
			eq(N.IsExhausted(0, 50), true)
			eq(N.IsExhausted(50, 0), true)
			eq(N.IsExhausted(1, 1), false)
		end)
	end)
end
